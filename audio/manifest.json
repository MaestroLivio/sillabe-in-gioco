  "frasi": {
   "1": {
    "file": "audio/frasi/01.mp3",
    "dur": 1.541,
    "spoken": "Il gatto beve il latte"
   },
   "2": {
    "file": "audio/frasi/02.mp3",
    "dur": 1.489,
    "spoken": "La mamma lava i piatti"
   },
   "3": {
    "file": "audio/frasi/03.mp3",
    "dur": 1.463,
    "spoken": "Il cane mangia l'osso"
   },
   "4": {
    "file": "audio/frasi/04.mp3",
    "dur": 1.62,
    "spoken": "Il bimbo apre la porta"
   },
   "5": {
    "file": "audio/frasi/05.mp3",
    "dur": 1.646,
    "spoken": "La nonna cucina la torta"
   },
   "6": {
    "file": "audio/frasi/06.mp3",
    "dur": 1.567,
    "spoken": "Il sole scalda i prati"
   },
   "7": {
    "file": "audio/frasi/07.mp3",
    "dur": 1.541,
    "spoken": "La rana salta nel lago"
   },
   "8": {
    "file": "audio/frasi/08.mp3",
    "dur": 1.62,
    "spoken": "Il pesce nuota nel mare"
   },
   "9": {
    "file": "audio/frasi/09.mp3",
    "dur": 1.698,
    "spoken": "Il gatto dorme sul letto"
   },
   "10": {
    "file": "audio/frasi/10.mp3",
    "dur": 1.384,
    "spoken": "La mamma legge un libro"
   },
   "11": {
    "file": "audio/frasi/11.mp3",
    "dur": 1.646,
    "spoken": "Il cane gioca con la palla"
   },
   "12": {
    "file": "audio/frasi/12.mp3",
    "dur": 1.802,
    "spoken": "La bambina disegna un fiore"
   },
   "13": {
    "file": "audio/frasi/13.mp3",
    "dur": 1.933,
    "spoken": "Il papà guida la macchina rossa"
   },
   "14": {
    "file": "audio/frasi/14.mp3",
    "dur": 1.933,
    "spoken": "I bambini giocano nel cortile"
   },
   "15": {
    "file": "audio/frasi/15.mp3",
    "dur": 1.959,
    "spoken": "La maestra scrive alla lavagna"
   },
   "16": {
    "file": "audio/frasi/16.mp3",
    "dur": 1.776,
    "spoken": "Il gatto insegue il topolino"
   },
   "17": {
    "file": "audio/frasi/17.mp3",
    "dur": 1.907,
    "spoken": "Il contadino raccoglie le mele"
   },
   "18": {
    "file": "audio/frasi/18.mp3",
    "dur": 2.168,
    "spoken": "La pioggia bagna i fiori del giardino"
   },
   "19": {
    "file": "audio/frasi/19.mp3",
    "dur": 1.829,
    "spoken": "Il treno arriva alla stazione"
   },
   "20": {
    "file": "audio/frasi/20.mp3",
    "dur": 1.907,
    "spoken": "La farfalla vola sopra il prato"
   },
   "21": {
    "file": "audio/frasi/21.mp3",
    "dur": 1.933,
    "spoken": "Il gatto dorme e il cane abbaia"
   },
   "22": {
    "file": "audio/frasi/22.mp3",
    "dur": 2.168,
    "spoken": "La mamma cucina e il papà apparecchia"
   },
   "23": {
    "file": "audio/frasi/23.mp3",
    "dur": 2.064,
    "spoken": "Piove forte ma il bambino esce"
   },
   "24": {
    "file": "audio/frasi/24.mp3",
    "dur": 2.09,
    "spoken": "Il topo corre e il gatto lo insegue"
   },
   "25": {
    "file": "audio/frasi/25.mp3",
    "dur": 2.038,
    "spoken": "La luna sorge e le stelle brillano"
   },
   "26": {
    "file": "audio/frasi/26.mp3",
    "dur": 2.247,
    "spoken": "Il vento soffia poi arriva la pioggia"
   },
   "27": {
    "file": "audio/frasi/27.mp3",
    "dur": 1.985,
    "spoken": "Il bimbo ride e la mamma sorride"
   },
   "28": {
    "file": "audio/frasi/28.mp3",
    "dur": 2.194,
    "spoken": "Il pane è pronto ma la zuppa è fredda"
   },
   "29": {
    "file": "audio/frasi/29.mp3",
    "dur": 1.933,
    "spoken": "Il cane salta e la palla rotola"
   },
   "30": {
    "file": "audio/frasi/30.mp3",
    "dur": 2.168,
    "spoken": "La nave parte e il gabbiano vola"
   },
   "31": {
    "file": "audio/frasi/31.mp3",
    "dur": 2.22,
    "spoken": "Quando piove il bambino apre l'ombrello"
   },
   "32": {
    "file": "audio/frasi/32.mp3",
    "dur": 2.325,
    "spoken": "Se il sole splende i fiori si aprono"
   },
   "33": {
    "file": "audio/frasi/33.mp3",
    "dur": 2.038,
    "spoken": "Perché è tardi il bimbo va a letto"
   },
   "34": {
    "file": "audio/frasi/34.mp3",
    "dur": 2.534,
    "spoken": "Dopo la scuola i bambini giocano al parco"
   },
   "35": {
    "file": "audio/frasi/35.mp3",
    "dur": 2.769,
    "spoken": "Mentre la mamma cucina il papà legge il giornale"
   },
   "36": {
    "file": "audio/frasi/36.mp3",
    "dur": 2.612,
    "spoken": "Quando arriva la primavera gli uccelli cantano"
   },
   "37": {
    "file": "audio/frasi/37.mp3",
    "dur": 1.829,
    "spoken": "Se bevi poca acqua hai sete"
   },
   "38": {
    "file": "audio/frasi/38.mp3",
    "dur": 2.351,
    "spoken": "Prima di uscire il bimbo mette il cappotto"
   },
   "39": {
    "file": "audio/frasi/39.mp3",
    "dur": 2.952,
    "spoken": "Quando la campana suona gli alunni entrano in classe"
   },
   "40": {
    "file": "audio/frasi/40.mp3",
    "dur": 2.247,
    "spoken": "Poiché è festa la scuola resta chiusa"
   }
  },
