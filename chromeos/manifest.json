{
  "manifest_version": 3,
  "name": "Sillabe in Gioco",
  "short_name": "Sillabe",
  "version": "2.2.1",
  "description": "Laboratorio di letto-scrittura: impara a leggere e scrivere componendo frasi con le sillabe.",
  "default_locale": "it",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Apri Sillabe in Gioco",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "offline_enabled": true,
  "minimum_chrome_version": "100"
}
